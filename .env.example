# ==========================================
# Configuración de CDN - Dominio Launcher
# ==========================================

# URL base de tu CDN o servidor de archivos (Cloudflare R2, AWS S3, Nginx, etc.)
VITE_CDN_URL=https://cdn.tudominio.com

# URL directa al archivo de manifiesto de mods (modpack.json)
# Si no se especifica, tomará ${VITE_CDN_URL}/modpack.json
VITE_MODPACK_URL=https://cdn.tudominio.com/modpack.json

# URL directa al archivo JSON con las noticias de la pantalla principal (news.json)
# Si no se especifica, tomará ${VITE_CDN_URL}/news.json
VITE_NEWS_URL=https://cdn.tudominio.com/news.json

# URL del servidor de desarrollo de Vite (usado internamente por Electron en modo dev)
VITE_DEV_SERVER_URL=
